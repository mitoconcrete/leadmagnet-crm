meta {
  name: links-create
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/admin/forms/{{formId}}/links
  body: json
  auth: none
}

headers {
  Cookie: sid={{sid}}
}

body:json {
  {
    "channel": "instagram"
  }
}

script:post-response {
  bru.setVar('code', res.body.code);
}

assert {
  res.status: eq 201
  res.body.channel: eq instagram
}
