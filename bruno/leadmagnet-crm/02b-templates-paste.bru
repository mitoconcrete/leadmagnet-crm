meta {
  name: templates-paste
  type: http
  seq: 2.5
}

post {
  url: {{baseUrl}}/api/admin/templates
  body: multipartForm
  auth: none
}

headers {
  Cookie: sid={{sid}}
}

body:multipart-form {
  html: <form><input name="email"></form>
  name: Bruno 붙여넣기 템플릿 {{$timestamp}}
}

script:post-response {
  bru.setVar('pasteTemplateId', res.body.id);
}

assert {
  res.status: eq 201
  res.body.originalFilename: contains Bruno 붙여넣기 템플릿
  res.body.originalFilename: contains .html
}
